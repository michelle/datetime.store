# Keep sandbox until the complete end-to-end test passes. Change to production only at cutover.
APP_ENV=sandbox

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret for the /api/webhooks/stripe endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Prodigi Print API. Sandbox: https://api.sandbox.prodigi.com/v4.0, live: https://api.prodigi.com/v4.0
PRODIGI_API_KEY=...
PRODIGI_API_BASE=https://api.sandbox.prodigi.com/v4.0

# Canonical public origin used for security checks and artwork URLs.
SITE_URL=http://localhost:3000
